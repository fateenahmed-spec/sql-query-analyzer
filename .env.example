# Local MySQL settings; replace the placeholder credentials for your machine.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=analyzer_ro
DB_PASS=your-local-app-password
DB_NAME=sql_analyzer_test
DB_ADMIN_USER=root
MYSQL_ROOT_PASSWORD=your-local-root-password
# TLS avoids caching_sha2_password cold-auth failures after MySQL restarts.
DB_SSL=true
DB_SSL_CA=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model
PUBLIC_MODE=false
PORT=8000
