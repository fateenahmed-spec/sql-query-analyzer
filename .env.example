# Copy this file to .env for local development and replace each placeholder.
DB_HOST=your-aiven-hostname
DB_PORT=your-aiven-port
DB_USER=your-aiven-username
DB_PASS=your-aiven-password
DB_NAME=your-aiven-database
DB_ADMIN_USER=your-aiven-admin-username
MYSQL_ROOT_PASSWORD=your-aiven-admin-password
DB_SSL=true
DB_SSL_CA=/path/to/aiven-ca.pem
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model
PUBLIC_MODE=true
PORT=10000
